---
import '../styles/tokens.css';
import ChapterBand from '../components/ChapterBand.astro';
import ProjectFigure from '../components/ProjectFigure.astro';
import Icon from '../components/Icon.astro';
import { person, profile, journey, work, skills, footer } from '../data/site';

const base = import.meta.env.BASE_URL;
const nav = [['profile', 'Profile'], ['journey', 'Journey'], ['work', 'Work'], ['skills', 'Skills']];
const pad = (n: number) => String(n).padStart(2, '0');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{person.name} · Data Science for Real-World Impact</title>
  <meta name="description" content={profile.statement} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&family=Inter:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="wrap bar">
      <a class="brand" href="#profile">
        <span class="name">{person.name}</span>
        <span class="label">{person.tagline.map((t, i) => <>{i > 0 && <span class="x">×</span>}{t}</>)}</span>
      </a>
      <nav aria-label="Sections">
        {nav.map(([id, text], i) => <a href={`#${id}`}><span class="n">{pad(i + 1)}</span>{text}</a>)}
        <a href="#contact">Contact</a>
      </nav>
      <p class="label motto">{person.motto[0]}<br />{person.motto[1]}</p>
    </div>
  </header>

  <main>
    <!-- 01 PROFILE -->
    <ChapterBand id="profile" num={1} name="Profile" keywords={profile.keywords} tone="cream" minH="60vh">
      <div class="profile">
        <div class="intro">
          <h1 id="profile-title" class="hero">{profile.headline[0]}<br />{profile.headline[1].replace(/\.$/, '')}<span class="stop">.</span></h1>
          <p class="lead">{profile.statement}</p>
          <ul class="pills">{profile.pills.map((t) => <li class="pill">{t}</li>)}</ul>
          <p class="actions spot">
            <a class="btn best" href={work.moreProjects}>View more projects <Icon name="arrow" /></a>
            <a class="btn" href={person.github}><Icon name="github" /> GitHub</a>
            <a class="btn contact" href={`mailto:${person.email}`}><Icon name="mail" /><span>Contact Me<small>{person.email}</small></span></a>
          </p>
        </div>

        <div class="vrule visual">
          <img class="art" src={`${base}img/leaf.png`} alt="Botanical illustration of a leafy green stem over pale beige squares." width="548" height="396" />
        </div>

        <aside class="glance" aria-labelledby="glance-title">
          <p id="glance-title" class="label glance-title">At a glance</p>
          <ul>
            {profile.glance.map((g) => (
              <li><Icon name={g.icon} size={22} /><span><strong>{g.title}</strong>{g.text}</span></li>
            ))}
          </ul>
        </aside>
      </div>
    </ChapterBand>

    <!-- 02 JOURNEY -->
    <ChapterBand id="journey" num={2} name="Journey" keywords={journey.keywords} tone="sky" minH="0">
      <div class="journey-head">
        <h2 id="journey-title" class="chapter-title">{journey.title}</h2>
        <p class="journey-sub">{journey.subtitle}</p>
      </div>

      <ol class="timeline spot">
        {journey.steps.map((s, i) => (
          <li class:list={['step', { 'last best': i === journey.steps.length - 1 }]}>
            <p class="dates">{s.dates}{s.now && <em>{s.now}</em>}</p>
            <h3>{s.title}</h3>
            <p class="place">{s.place}</p>
            <p class="desc">{s.text}</p>
          </li>
        ))}
        <li class="end" aria-hidden="true"><span class="ring"></span></li>
      </ol>
    </ChapterBand>

    <!-- 03 WORK -->
    <ChapterBand id="work" num={3} name="Work" keywords={work.keywords} tone="cream" minH="91vh">
      <div class="work-head">
        <h2 id="work-title" class="chapter-title">Selected Work.</h2>
        <p class="work-intro">{work.projects.length} featured projects · {work.extra.length} more below</p>
        <a class="all" href={work.moreProjects}>View more projects <Icon name="arrow" size={20} /></a>
      </div>

      <div class="cards spot">
        {work.projects.map((p, i) => (
          <article class:list={['card', { best: p.badge }]} style={p.badge && `--c: var(--${p.badge === 'new' ? 'red' : 'blue'})`}>
            {p.badge && <span class="badge">{p.badge}</span>}
            <p class="card-top"><span class="num">{pad(i + 1)}</span><span class="label">{p.area}</span></p>
            <ProjectFigure kind={p.figure} label={`${p.title}: schematic figure`} />
            <h3>{p.title}</h3>
            <p class="role">{p.role}</p>
            <ul class="bullets">{p.bullets.map((b) => <li>{b}</li>)}</ul>
            <p class="tags">{p.tags.map((t, j) => <span class="tag">{t}{j < p.tags.length - 1 && <span class="sep"><span aria-hidden="true">•</span><span class="vh">, </span></span>}</span>)}</p>
          </article>
        ))}
      </div>

      <div class="more-wrap">
      <div class="also">
        <p class="label also-title">Also built</p>
        <ul>{work.extra.map((a) => <li><strong>{a.title}</strong><span>{a.text}</span></li>)}</ul>
      </div>
      <details class="see-more">
        <summary><span class="see-label"><span class="when-closed">Expand these projects</span><span class="when-open">Collapse</span></span></summary>
        <div class="cards extra spot">
          {work.extra.map((p, i) => (
            <article class="card">
              <p class="card-top"><span class="num">{pad(work.projects.length + i + 1)}</span><span class="label">{p.area}</span></p>
              <h3>{p.title}</h3>
              <p class="role">{p.role}</p>
              <ul class="bullets">{p.bullets.map((b) => <li>{b}</li>)}</ul>
              <p class="tags">{p.tags.map((t, j) => <span class="tag">{t}{j < p.tags.length - 1 && <span class="sep"><span aria-hidden="true">•</span><span class="vh">, </span></span>}</span>)}</p>
            </article>
          ))}
        </div>
      </details>
      </div>
    </ChapterBand>

    <!-- 04 SKILLS & WHAT'S NEXT -->
    <ChapterBand id="skills" num={4} name="Skills" keywords={skills.keywords} tone="navy" minH="36vh">
      <div class="skills">
        <div class="skills-title">
          <h2 id="skills-title" class="chapter-title">{skills.title}</h2>
          <p class="skills-sub">{skills.subtitle}</p>
          <ul class="label legend">{['Familiar', 'Proficient', 'Advanced'].map((t, i) => <li><span class={`lvl l${i + 1}`}><i></i><i></i><i></i></span>{t}</li>)}</ul>
        </div>
        {skills.groups.map((g) => (
          <div class="vrule group">
            <h3 class="label">{g.title}</h3>
            <ul class="pills spot">{g.pills.map((p) => (
              <li class:list={['pill', { best: p.best }]}>{p.name}<span class={`lvl l${p.level}`} role="img" aria-label={`${['', 'familiar', 'proficient', 'advanced'][p.level]}`}><i></i><i></i><i></i></span></li>
            ))}</ul>
          </div>
        ))}
        <div class="direction">
          <p class="label"><Icon name="target" size={26} />Current direction</p>
          <p class="direction-text">{skills.direction}</p>
          <p class="spot"><a class="btn talk" href={`mailto:${person.email}`}><Icon name="mail" /> Contact Me</a></p>
        </div>
      </div>
    </ChapterBand>
  </main>

  <footer id="contact" class="site-footer">
    <div class="wrap foot">
      <div class="foot-brand">
        <p class="name">{person.name}</p>
        <p class="label">{footer.role}</p>
      </div>
      <p class="vrule foot-quote">“{footer.quote}”</p>
      <ul class="vrule social">
        <li><a href={person.github} aria-label="GitHub"><Icon name="github" size={30} /></a></li>
        <li><a href={person.linkedin} aria-label="LinkedIn"><Icon name="linkedin" size={30} /></a></li>
        <li><a href={`mailto:${person.email}`} aria-label={`Email ${person.email}`}><Icon name="mail" size={32} /></a></li>
      </ul>
      <p class="vrule label open">{footer.open[0]}<br />{footer.open[1]}</p>
    </div>
  </footer>
  <script>
    // Nav underline follows the section in view.
    const links = new Map([...document.querySelectorAll('nav a')].map((a) => [a.hash.slice(1), a]));
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) links.forEach((a, id) => a.toggleAttribute('aria-current', id === e.target.id));
    }, { rootMargin: '-45% 0px -50% 0px' });
    document.querySelectorAll('main > section, footer').forEach((el) => io.observe(el));
  </script>
</body>
</html>

<style>
  /* ── Header ─────────────────────────────── */
  .site-header { position: sticky; top: 0; z-index: 10; height: var(--header-h); background: var(--cream); }
  .bar { height: 100%; display: flex; align-items: center; gap: 2rem; position: relative; }
  .bar::after { content: ''; position: absolute; left: var(--margin); right: var(--margin); bottom: 0; border-bottom: 1px solid var(--hair); }
  .brand { display: flex; flex-direction: column; gap: 0.15rem; text-decoration: none; margin-right: auto; }
  .brand .name { font-size: 1.7rem; font-weight: 700; letter-spacing: -0.025em; line-height: 1.05; }
  .brand .label { font-size: 0.62rem; color: var(--muted); }
  nav { display: flex; gap: clamp(1.25rem, 2.6vw, 2.75rem); margin-right: clamp(1rem, 4vw, 4.5rem); }
  nav a { text-decoration: none; font-size: 1.02rem; padding: 0.3rem 0; border-bottom: 1px solid transparent; }
  nav a { border-bottom-width: 2px; transition: border-color 0.2s; }
  nav a:hover, nav a[aria-current] { border-bottom-color: var(--red); }
  nav .n { color: var(--red); }
  nav .n { margin-right: 0.55em; font-variant-numeric: lining-nums; }
  .motto { text-align: right; font-size: 0.62rem; line-height: 1.9; color: var(--muted); }

  .short-rule { display: block; width: 52px; border-top: 2px solid var(--c, currentColor); }

  /* ── 01 Profile: text | art | at a glance ─────────────── */
  .profile { display: grid; grid-template-columns: 58fr 20fr 22fr; column-gap: clamp(1.25rem, 2.5vw, 2.5rem); align-items: center; }
  .intro { display: flex; flex-direction: column; justify-content: center; }
  .stop { color: var(--red); }
  .hero { font-size: clamp(2.3rem, 1.2rem + 2.1vw, 3.3rem); font-weight: 700; line-height: 0.98; letter-spacing: -0.04em; margin: 0 0 1.4rem -0.04em; }
  .lead { font-size: clamp(1.05rem, 0.95rem + 0.35vw, 1.25rem); line-height: 1.5; max-width: 32em; }
  .pills { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .intro .pills { margin-top: 1.25rem; }
  .pill { white-space: nowrap; padding: 0.3em 0.95em; border-radius: 999px; font-size: 0.9rem; line-height: 1.4;
    background: color-mix(in srgb, var(--c, var(--blue)) calc(14% + var(--lit, 0) * 86%), transparent);
    color: color-mix(in srgb, var(--pill-on, var(--paper)) calc(var(--lit, 0) * 100%), currentColor);
    transition: background 0.25s, color 0.25s; }
  .intro .pill { --c: var(--blue); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 1.6rem; }
  .actions { gap: 0.7rem; }
  .actions .btn { padding: 0.85em 1.15em; gap: 0.6rem; }
  /* contact buttons carry the address as a second line */
  .contact span { line-height: 1.15; }
  .contact small { display: block; margin-top: 0.3em; font: 400 0.7rem / 1 var(--sans); letter-spacing: 0.02em; opacity: 0.75; }
  .actions .contact { padding-block: 0.6em; }
  .visual { position: relative; align-self: stretch; min-height: clamp(280px, 38vh, 420px); }
  .art { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply;
    -webkit-mask-image: radial-gradient(closest-side, #000 80%, transparent); mask-image: radial-gradient(closest-side, #000 80%, transparent); }  /* soft edge so its off-white ground melts into the cream */
  .glance { background: color-mix(in srgb, var(--sky) 70%, white); padding: 1.4rem 1.4rem 1.2rem; }
  .glance-title { font-size: 0.62rem; font-weight: 600; margin-bottom: 1rem; }
  .glance li { display: flex; gap: 0.9rem; align-items: flex-start; padding: 0.6rem 0; font-size: 0.85rem; line-height: 1.35; }
  .glance li + li { border-top: 1px solid var(--hair); }
  .glance li :global(.icon) { flex: none; color: var(--navy); margin-top: 0.1rem; }
  .glance strong { display: block; font-weight: 600; font-size: 0.95rem; }

  /* ── 02 Journey: title + subtitle, horizontal timeline ─────────── */
  .journey-head { margin-bottom: clamp(2rem, 5vh, 3.5rem); }
  .journey-sub { margin-top: 0.8rem; font-size: 1.12rem; max-width: 40em; opacity: 0.9; }

  .timeline { --c: var(--red); --gap: clamp(1rem, 2vw, 1.75rem); display: grid; grid-template-columns: repeat(5, 1fr) 30px; column-gap: var(--gap); padding-top: 1rem; }
  .timeline li { position: relative; }
  /* track: each item draws its own segment to the next column */
  .timeline li::after { content: ''; position: absolute; top: 0; left: 0; right: calc(-1 * var(--gap)); border-top: 1.5px solid var(--navy); }
  .timeline .end::after { display: none; }
  .step::before { content: ''; position: absolute; z-index: 1; top: -6px; left: -6px; width: 13px; height: 13px; border-radius: 50%; background: color-mix(in srgb, var(--c) calc(var(--lit) * 100%), var(--navy)); transition: background 0.25s, transform 0.25s; transform: scale(calc(1 + var(--lit) * 0.25)); }
  .step { padding: 2.1rem 0.9rem 1rem 1.2rem; border-left: 1px solid; border-image: linear-gradient(to bottom, transparent 1.4rem, var(--hair) 1.4rem) 1;
    background: linear-gradient(color-mix(in srgb, white calc(var(--lit) * 45%), transparent) 0 0) 0 1.4rem / 100% calc(100% - 1.4rem) no-repeat; }
  .step .dates { color: color-mix(in srgb, var(--c) calc(var(--lit) * 100%), currentColor); }
  .dates { font-size: 0.95rem; opacity: 0.85; margin-bottom: 0.5rem; font-variant-numeric: lining-nums; }
  .dates em { margin-left: 0.3em; }
  .step h3 { font-size: 1.12rem; font-weight: 700; line-height: 1.25; letter-spacing: -0.005em; }
  .place { font-size: 0.98rem; margin: 0.15rem 0 0.7rem; opacity: 0.85; }
  .desc { font-size: 0.95rem; line-height: 1.55; opacity: 0.8; }
  .ring { position: absolute; top: -15px; right: 0; width: 30px; height: 30px; border: 2px solid var(--navy); border-radius: 50%; background: var(--sky); }

  /* ── 03 Work: head row, five cards with bullets, see-more cards ── */
  .work-head { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.75rem clamp(1.25rem, 2.5vw, 2.5rem); margin-bottom: clamp(1.75rem, 3.5vh, 2.5rem); }
  .work-intro { font-size: 1.08rem; line-height: 1.5; }
  .all { margin-left: auto; display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; padding-bottom: 0.2rem; border-bottom: 1.5px solid var(--navy); }
  .all:hover :global(.icon) { transform: translateX(3px); }
  .all :global(.icon) { transition: transform 0.2s; }

  .cards { --c: var(--red); display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(0.85rem, 1.3vw, 1.25rem); }
  .card { position: relative; display: flex; flex-direction: column; padding: clamp(1rem, 1.3vw, 1.3rem); background: white; border: 1px solid var(--card-line);
    outline: 2px solid color-mix(in srgb, var(--c) calc(var(--lit) * 100%), transparent); outline-offset: -1px;
    transform: translateY(calc(var(--lit) * -3px)); box-shadow: 0 calc(var(--lit) * 8px) calc(var(--lit) * 20px) rgb(14 38 56 / 0.12);
    transition: outline-color 0.25s, transform 0.25s, box-shadow 0.25s; }
  .badge { position: absolute; top: -0.75em; right: 1rem; padding: 0.35em 0.75em; background: var(--c); color: var(--paper); font: 600 0.58rem / 1.2 var(--sans); letter-spacing: 0.18em; text-transform: uppercase; }
  .card-top { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 0.9rem; }
  .card-top .num { font-size: 1.1rem; font-weight: 700; }
  .card-top .label { font-size: 0.6rem; color: var(--muted); }
  .card :global(.fig) { margin-bottom: 1.1rem; }
  .card h3 { font-size: 1.12rem; font-weight: 700; line-height: 1.2; letter-spacing: -0.01em; }
  .role { font-size: 0.82rem; font-style: italic; opacity: 0.7; margin: 0.25rem 0 0.75rem; }
  .bullets { list-style: disc; padding-left: 1.1em; font-size: 0.86rem; line-height: 1.45; margin-bottom: 1.1rem; }
  .bullets li + li { margin-top: 0.25rem; }
  .bullets li::marker { color: var(--c); }
  .tags { margin-top: auto; display: flex; flex-wrap: wrap; align-items: center; row-gap: 0.15rem; font-size: 0.8rem; color: var(--muted); }
  .tag { white-space: nowrap; }
  .sep { margin: 0 0.5em; color: var(--accent); }

  /* Also-built preview; "Expand" (native <details>) swaps it for full cards */
  .also { margin-top: clamp(1.75rem, 3.5vh, 2.5rem); }
  .also-title { display: flex; align-items: center; gap: 1.1rem; font-size: 0.64rem; color: var(--muted); margin-bottom: 1.25rem; }
  .also-title::after { content: ''; flex: 1; border-top: 1px solid var(--hair); }
  .also ul { display: grid; grid-template-columns: repeat(4, 1fr); }
  .also li { display: flex; flex-direction: column; gap: 0.25rem; padding: 0.1rem 1.25rem; border-left: 1px solid var(--hair); font-size: 0.92rem; line-height: 1.45; }
  .also li:first-child { border-left: 0; padding-left: 0; }
  .also strong { font-weight: 600; font-size: 1rem; }
  .also span { opacity: 0.78; }
  .more-wrap:has(> .see-more[open]) > .also { display: none; }
  .see-more { margin-top: 1.25rem; }
  .see-more summary { display: inline-flex; cursor: pointer; list-style: none; font: 500 0.66rem / 1 var(--sans); letter-spacing: 0.26em; text-transform: uppercase; }
  .see-more summary::-webkit-details-marker { display: none; }
  .see-label { border-bottom: 1.5px solid var(--navy); padding-bottom: 0.3rem; }
  .see-label::after { content: ' ↓'; }
  .see-more[open] .see-label::after { content: ' ↑'; }
  .see-more .when-open, .see-more[open] .when-closed { display: none; }
  .see-more[open] .when-open { display: inline; }
  .cards.extra { grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 1.5rem; }

  /* ── 04 Skills: title | two pill groups | direction card ── */
  .skills { --pill-on: var(--navy); display: grid; grid-template-columns: 0.95fr 1.45fr 1.15fr 1fr; column-gap: clamp(1.25rem, 2.5vw, 2.5rem); align-items: center; }
  .skills-title .chapter-title { font-size: clamp(2.2rem, 1rem + 2vw, 3rem); }
  .skills-sub { margin-top: 0.9rem; font-size: 1.05rem; opacity: 0.9; }
  .group { align-self: stretch; }
  .group h3 { font-size: 0.64rem; font-weight: 600; margin-bottom: 1rem; }
  .group .pill { --c: var(--blue); font-size: 0.86rem; }
  .direction { background: var(--navy-2); padding: 1.4rem; }
  .direction .label { display: flex; align-items: center; gap: 0.8rem; font-size: 0.64rem; font-weight: 600; }
  /* skill level: three dots, filled up to the level; currentColor so lit pills invert them */
  .lvl { display: inline-flex; gap: 3px; margin-left: 0.55em; vertical-align: 0.05em; }
  .lvl i { width: 6px; height: 6px; border-radius: 50%; border: 1px solid currentColor; opacity: 0.85; }
  .l1 i:nth-child(1), .l2 i:nth-child(-n + 2), .l3 i { background: currentColor; }
  .legend { margin-top: 1.1rem; display: grid; gap: 0.35rem; font-size: 0.58rem; opacity: 0.8; }
  .legend .lvl { margin: 0 0.8em 0 0; }
  .direction-text { font-size: 0.95rem; line-height: 1.5; margin: 0.9rem 0 1.2rem; opacity: 0.92; }
  .talk { --btn: var(--paper-ink); --btn-ink: var(--navy); padding: 0.6em 1.3em; }

  /* ── Footer ─────────────────────────────── */
  .site-footer { display: flex; align-items: center; padding: 1.5rem 0; }
  .foot { width: 100%; display: grid; grid-template-columns: 1.25fr 1.7fr 1fr 1fr; align-items: center; column-gap: clamp(1.5rem, 3vw, 3rem); }
  .foot > .vrule { min-height: 64px; display: flex; align-items: center; }
  .foot-brand .name { font-size: 1.7rem; font-weight: 700; letter-spacing: -0.025em; line-height: 1.1; }
  .foot-brand .label { font-size: 0.62rem; color: var(--muted); margin-top: 0.3rem; }
  .foot-quote { justify-content: center; font-style: italic; font-size: 1.2rem; }
  .social { justify-content: center; gap: 1.75rem; }
  .social a { display: inline-flex; color: var(--navy); transition: color 0.2s, transform 0.2s; }
  .social a:hover { color: var(--accent); transform: translateY(-2px); }
  .open { justify-content: center; text-align: center; font-size: 0.62rem; line-height: 2.1; color: var(--muted); }

  /* ── Responsive ─────────────────────────── */
  @media (max-width: 1099px) {
    /* vertical timeline: six columns get too narrow below this */
    .timeline { grid-template-columns: 1fr; padding: 0 0 0 0.5rem; max-width: 40rem; }
    .timeline li::after { top: 0; bottom: 0; left: 0; right: auto; border-top: 0; border-left: 1.5px solid var(--navy); }
    .step { border: 0; padding: 0 0 2.25rem 1.75rem; }
    .step::before { top: 0.35rem; }
    .timeline .end { display: none; }
  }
  @media (max-width: 1199px) {
    .motto { display: none; }
    .profile { grid-template-columns: 1fr 1fr; row-gap: 2rem; }
    .intro { grid-column: 1 / -1; }
    .skills { grid-template-columns: 1fr 1fr; row-gap: 2rem; }
    .card { padding: 0.9rem; }
    .card-top { gap: 0.6rem; }
